{
  // Type-checking only for src/ (vite.config.ts runs in Node and would need
  // the extra @types/node package to check). Vite does the actual compiling/bundling, so tsc
  // never writes files ("noEmit"). Strict mode catches the most mistakes.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    // Let TypeScript files import plain .js files (e.g. src/view-as.js).
    // checkJs stays off (the default), so the .js files themselves aren't
    // type-checked; TypeScript only reads their JSDoc comments for types.
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
